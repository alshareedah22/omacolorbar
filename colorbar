#!/usr/bin/env python3
"""colorbar: swap Omarchy's built-in bar widgets for OmaColorBar copies, or put them back.

  colorbar setup [shell.json]            what the plugin runs by itself when it is first enabled:
                                         swap every supported built-in and add the settings key,
                                         only while the layout holds just the bare entry that
                                         `omarchy plugin enable` puts there (no other copy yet)
  colorbar swap [shell.json] [--force]   back up shell.json, then swap every supported
                                         built-in for a color copy in the same place
  colorbar unswap [shell.json]           the gentle undo: turn every OmaColorBar copy back into its
                                         built-in in the same place, keep all other changes, no
                                         backup needed (writes a timestamped safety copy first)
  colorbar restore [shell.json]          put the swap backup back as the whole file, discarding
                                         every change made since (prefer unswap)
  colorbar bind [bindings.lua]           add SUPER+CTRL+ALT+C (open the settings panel) to
                                         ~/.config/hypr/bindings.lua
  colorbar unbind [bindings.lua]         remove that binding again

A swapped widget's own settings move to its plugins[] entry, where Omarchy keeps the
settings of a widget that is not in the layout. The copy reads them from there; the hosted
widget cannot save inline changes itself (the shell scopes those saves to the calling plugin)."""
import fcntl
import json
import os
import sys
import tempfile
import time

PLUGIN = "blackcode.omacolorbar"
SUPPORTED = ["omarchy.menu", "omarchy.network", "omarchy.bluetooth", "omarchy.audio",
             "omarchy.microphone", "omarchy.power", "omarchy.monitor", "omarchy.system-update",
             "omarchy.agents", "omarchy.tailscale", "omarchy.tray", "omarchy.weather"]
DEFAULT = os.path.expanduser("~/.config/omarchy/shell.json")
SUFFIX = ".omacolorbar-backup"
BINDINGS = os.path.expanduser("~/.config/hypr/bindings.lua")
KEYS = "SUPER + CTRL + ALT + C"
MARK = "-- OmaColorBar settings panel (colorbar unbind removes these two lines)\n"
BIND = ('o.bind("' + KEYS + '", "OmaColorBar settings", '
        '"qs -p /usr/share/omarchy/shell ipc call omacolorbar toggleSettings")\n')


def swapped(config):
    out = json.loads(json.dumps(config))
    layout = out.get("bar", {}).get("layout", {}) if isinstance(out.get("bar"), dict) else {}
    for section in ("left", "center", "right"):
        entries = layout.get(section)
        if not isinstance(entries, list):
            continue
        for i, entry in enumerate(entries):
            if not isinstance(entry, dict) or entry.get("id") not in SUPPORTED:
                continue
            widget = entry["id"]
            entries[i] = {"id": PLUGIN, "icon": widget}
            plugins = out.setdefault("plugins", [])
            existing = next((p for p in plugins if isinstance(p, dict) and p.get("id") == widget), None)
            extra = {k: v for k, v in entry.items() if k != "id"}
            if existing is None:
                plugins.append({"id": widget, **extra})
            else:
                existing.update(extra)
    return out


def write_atomic(path, data, mode):
    folder = os.path.dirname(path)
    fd, tmp = tempfile.mkstemp(dir=folder, prefix=".colorbar-", suffix=".tmp")
    try:
        with os.fdopen(fd, "wb") as f:
            f.write(data)
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    except BaseException:
        if os.path.lexists(tmp):
            os.unlink(tmp)
        raise


def fail(message):
    print("colorbar: " + message, file=sys.stderr)
    sys.exit(1)


def shape_problem(config):
    if not isinstance(config, dict):
        return "shell.json must hold a JSON object"
    bar = config.get("bar")
    if isinstance(bar, dict) and "layout" in bar:
        layout = bar["layout"]
        if not isinstance(layout, dict):
            return "bar.layout must be an object"
        for section in ("left", "center", "right"):
            if section in layout and not isinstance(layout[section], list):
                return f"bar.layout.{section} must be a list"
    if "plugins" in config and not isinstance(config["plugins"], list):
        return "plugins must be a list"
    return None


def swap(path, force):
    backup = path + SUFFIX
    try:
        with open(path, "rb") as f:
            raw = f.read()
        config = json.loads(raw)
    except (OSError, ValueError) as e:
        fail(f"cannot read {path}: {e}")
    problem = shape_problem(config)
    if problem:
        fail(f"{problem}; nothing was changed")
    if os.path.exists(backup) and not force:
        fail(f"a backup already exists at {backup}; run restore first, or swap --force")
    result = swapped(config)
    if result == config:
        print("nothing to swap: no supported built-in widgets in the layout")
        return
    text = json.dumps(result, indent=2) + "\n"
    mode = os.stat(path).st_mode & 0o777
    kept = os.path.exists(backup)
    if not kept:
        write_atomic(backup, raw, mode)
    write_atomic(path, text.encode(), mode)
    if kept:
        print(f"kept the existing backup at {backup}; it holds the original, and the current file was swapped")
    else:
        print(f"swapped; the original is at {backup}")


def is_bare(entry):
    return isinstance(entry, dict) and entry.get("id") == PLUGIN and not entry.get("icon")


def layout_entries(config):
    bar = config.get("bar") if isinstance(config, dict) else None
    layout = bar.get("layout") if isinstance(bar, dict) else None
    if not isinstance(layout, dict):
        return []
    return [e for s in ("left", "center", "right") if isinstance(layout.get(s), list) for e in layout[s]]


def needs_setup(config):
    """A fresh enable: the bare entry Omarchy adds is there, and no copy has an icon yet."""
    entries = layout_entries(config)
    copies = [e for e in entries if isinstance(e, dict) and e.get("id") == PLUGIN]
    return bool(copies) and all(is_bare(e) for e in copies)


def without_bare(config):
    out = json.loads(json.dumps(config))
    layout = out.get("bar", {}).get("layout", {}) if isinstance(out.get("bar"), dict) else {}
    for section in ("left", "center", "right"):
        if isinstance(layout.get(section), list):
            layout[section] = [e for e in layout[section] if not is_bare(e)]
    return out


def set_up(config):
    """The swapped layout for a fresh enable. The bare entry Omarchy placed becomes the network
    copy when the bar had no network widget, and is dropped otherwise."""
    out = swapped(config)
    network = any(isinstance(e, dict) and e.get("id") == PLUGIN and e.get("icon") == "omarchy.network"
                  for e in layout_entries(out))
    layout = out["bar"]["layout"]
    for section in ("left", "center", "right"):
        entries = layout.get(section)
        if not isinstance(entries, list):
            continue
        kept = []
        for entry in entries:
            if is_bare(entry):
                if network:
                    continue
                entry = {"id": PLUGIN, "icon": "omarchy.network"}
                network = True
            kept.append(entry)
        layout[section] = kept
    return out


def setup(path, bindings):
    # Every bare copy (one per monitor) and the service may start this at once.
    folder = os.environ.get("XDG_RUNTIME_DIR") or os.path.dirname(path)
    with open(os.path.join(folder, "omacolorbar-setup.lock"), "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        set_up_locked(path, bindings)


def set_up_locked(path, bindings):
    try:
        with open(path, "rb") as f:
            raw = f.read()
        config = json.loads(raw)
    except (OSError, ValueError) as e:
        fail(f"cannot read {path}: {e}")
    problem = shape_problem(config)
    if problem:
        fail(f"{problem}; nothing was changed")
    if not needs_setup(config):
        print("already set up")
        return
    mode = os.stat(path).st_mode & 0o777
    backup = path + SUFFIX
    # The backup is the bar as it was before the plugin: without the bare entry, so that a
    # restore does not set the plugin up again on the next start.
    if not os.path.exists(backup):
        write_atomic(backup, (json.dumps(without_bare(config), indent=2) + "\n").encode(), mode)
    write_atomic(path, (json.dumps(set_up(config), indent=2) + "\n").encode(), mode)
    print(f"set up: every supported widget now has a color icon; the previous bar is at {backup}")
    if bindings and os.path.exists(bindings):
        try:
            with open(bindings) as f:
                text = f.read()
        except OSError:
            return
        if MARK + BIND not in text and '"' + KEYS + '"' not in text:
            bind(bindings)


def unswapped(config):
    """Return (new config, list of (section, index, old, new-or-None)) with every copy undone."""
    out = json.loads(json.dumps(config))
    layout = out.get("bar", {}).get("layout", {}) if isinstance(out.get("bar"), dict) else {}
    network = any(isinstance(e, dict) and e.get("id") == "omarchy.network"
                  for s in ("left", "center", "right") if isinstance(layout.get(s), list)
                  for e in layout[s])
    changes = []
    for section in ("left", "center", "right"):
        entries = layout.get(section)
        if not isinstance(entries, list):
            continue
        kept = []
        for i, entry in enumerate(entries):
            if not isinstance(entry, dict) or entry.get("id") != PLUGIN:
                kept.append(entry)
                continue
            icon = entry.get("icon")
            if not isinstance(icon, str) or not icon:
                if network:
                    changes.append((section, i, entry, None))
                    continue
                icon = "omarchy.network"
            new = {"id": icon}
            changes.append((section, i, entry, new))
            kept.append(new)
        layout[section] = kept
    return out, changes


def unswap(path):
    try:
        with open(path, "rb") as f:
            raw = f.read()
        config = json.loads(raw)
    except (OSError, ValueError) as e:
        fail(f"cannot read {path}: {e}")
    problem = shape_problem(config)
    if problem:
        fail(f"{problem}; nothing was changed")
    result, changes = unswapped(config)
    if not changes:
        print("nothing to unswap: no OmaColorBar copies in the layout")
        return
    text = json.dumps(result, indent=2) + "\n"
    try:
        problem = shape_problem(json.loads(text))
    except ValueError as e:
        problem = str(e)
    if problem:
        fail(f"the result did not validate ({problem}); nothing was changed")
    mode = os.stat(path).st_mode & 0o777
    stamp = time.strftime("%Y%m%dT%H%M%SZ", time.gmtime())
    safety = f"{path}.omacolorbar-unswap-{stamp}"
    n = 1
    while os.path.exists(safety):
        n += 1
        safety = f"{path}.omacolorbar-unswap-{stamp}-{n}"
    write_atomic(safety, raw, mode)
    write_atomic(path, text.encode(), mode)
    for section, i, old, new in changes:
        print(f"{section}[{i}]: {json.dumps(old)} -> " + (json.dumps(new) if new else "removed (omarchy.network is already on the bar)"))
    print(f"unswapped {len(changes)} entr{'y' if len(changes) == 1 else 'ies'}; the previous file is at {safety}")


def backup_problem(backup):
    try:
        with open(backup, "rb") as f:
            data = json.loads(f.read())
    except (OSError, ValueError) as e:
        return f"the backup is not valid JSON ({e})"
    bar = data.get("bar") if isinstance(data, dict) else None
    if not isinstance(bar, dict) or not isinstance(bar.get("layout"), dict):
        return "the backup has no bar.layout object"
    return None


def restore(path):
    backup = path + SUFFIX
    if not os.path.exists(backup):
        fail(f"no backup at {backup}")
    problem = backup_problem(backup)
    if problem:
        fail(f"{problem}; refusing to restore {backup}. Nothing was changed. Try 'colorbar unswap' instead")
    os.replace(backup, path)
    print("restored the original; any changes made since the swap, including settings Omarchy saved, were replaced by the backup")


def reload_if_live(path):
    # Only the live file: tests and other paths never touch the running Hyprland.
    if path == os.path.realpath(BINDINGS):
        os.system("hyprctl reload >/dev/null 2>&1")


def bind(path):
    with open(path) as f:
        text = f.read()
    if MARK + BIND in text:
        print("already bound: SUPER+CTRL+ALT+C opens the OmaColorBar settings")
        return
    if '"' + KEYS + '"' in text:
        fail(f"{KEYS} is already bound in {path}; nothing was changed")
    sep = "" if text == "" or text.endswith("\n") else "\n"
    write_atomic(path, (text + sep + MARK + BIND).encode(), os.stat(path).st_mode & 0o7777)
    reload_if_live(path)
    print("bound: SUPER+CTRL+ALT+C opens the OmaColorBar settings ('colorbar unbind' removes it)")


def unbind(path):
    with open(path) as f:
        text = f.read()
    if MARK + BIND not in text:
        print("not bound; nothing to remove")
        return
    write_atomic(path, text.replace(MARK + BIND, "", 1).encode(), os.stat(path).st_mode & 0o7777)
    reload_if_live(path)
    print("unbound SUPER+CTRL+ALT+C")


def main(argv):
    args = [a for a in argv if not a.startswith("--")]
    force = "--force" in argv
    if not args or args[0] not in ("setup", "swap", "restore", "unswap", "bind", "unbind"):
        print(__doc__.strip())
        sys.exit(2)
    default = BINDINGS if args[0] in ("bind", "unbind") else DEFAULT
    path = os.path.realpath(args[1] if len(args) > 1 else default)
    if not os.path.exists(path):
        fail(f"no file at {path}")
    if args[0] == "setup":
        # The key goes into the live bindings only when the live shell.json is set up.
        live = path == os.path.realpath(DEFAULT)
        setup(path, os.path.realpath(BINDINGS) if live else None)
    elif args[0] == "swap":
        swap(path, force)
    elif args[0] == "unswap":
        unswap(path)
    elif args[0] == "bind":
        bind(path)
    elif args[0] == "unbind":
        unbind(path)
    else:
        restore(path)


if __name__ == "__main__":
    main(sys.argv[1:])
